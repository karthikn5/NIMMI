# Nimmi AI backend settings. Copy to .env and fill in.
# REQUIRED = the app won't work properly without it. Everything else turns a feature on.

# ─── Core ─────────────────────────────────────────────────────────
# REQUIRED in production (the server refuses to start without it). Postgres (Supabase).
# Use a long random password: Supabase -> Project Settings -> Database -> Reset database password.
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Open connections kept per server process (4 processes). Supabase's session pooler (port 5432)
# allows 15 clients in all, so the defaults (2 + 1 extra) stay under it. On the transaction pooler
# (port 6543 in the same URL) you can raise them, e.g. 5 and 5.
# DB_POOL_SIZE=2
# DB_POOL_OVERFLOW=1
# Local development only: SQLite and relaxed checks. Ignored on Railway, whatever it's set to.
LOCAL_DEV=false
# REQUIRED in production (refuses to start without it, min. 32 characters). Signs login tokens.
# Generate: python -c "import secrets; print(secrets.token_hex(32))". Changing it signs everyone out.
JWT_SECRET=
BACKEND_URL=https://api.nimmiai.in
DASHBOARD_URL=https://nimmiai.in
PORT=8000

# ─── AI ───────────────────────────────────────────────────────────
# REQUIRED. Chat answers, embeddings, call summaries. https://aistudio.google.com/
GEMINI_API_KEY=
# Recommended for voice: first word in ~0.1-0.2 s vs ~1.6 s for Gemini (measured). https://console.groq.com/
GROQ_API_KEY=
# Only if customers pick OpenAI for a bot. https://platform.openai.com/
OPENAI_API_KEY=
# Optional. Gemini models chat tries in order (a slow or failing one falls through to the next),
# and the small model used for picking details out of messages.
# CHAT_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# FAST_MODEL=gemini-flash-lite-latest

# ─── Knowledge (RAG) ──────────────────────────────────────────────
# REQUIRED for website/PDF knowledge search. https://www.pinecone.io/
PINECONE_API_KEY=
PINECONE_INDEX_NAME=nimmi-knowledge-base
# Embedding size is read from the index; this is only the fallback if it can't be read.
# EMBED_DIMENSIONS=768
# Knowledge up to this size is read in full by the assistant; bigger knowledge uses search.
# KNOWLEDGE_FULL_CONTEXT_CHARS=60000

# ─── Deployments (website hosting, see ops/SITES_SETUP.md) ────────
# Sites are published at <name>.SITES_DOMAIN. Use a separate domain from nimmiai.in.
SITES_DOMAIN=
# Shared secret between the Cloudflare edge worker and the backend (40+ random characters).
SITES_EDGE_KEY=
# Custom domains (paid plans) through Cloudflare for SaaS:
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CUSTOM_DOMAIN_TARGET=
# Local development only: where site files are kept when Supabase storage isn't configured.
# SITES_DIR=

# ─── Supabase (Google sign-in, image and recording storage) ───────
SUPABASE_URL=https://your-project.supabase.co
# Anon key: verifies Google sign-in tokens.
SUPABASE_KEY=
# Service-role (secret) key: logo uploads, call recordings and daily backups. Never expose to the browser.
# Without it in production, logo uploads fail and recordings last only until the next deploy.
SUPABASE_SERVICE_ROLE_KEY=
RECORDINGS_BUCKET=call-recordings

# ─── Payments (Razorpay) ──────────────────────────────────────────
# Use rzp_test_ keys locally and rzp_live_ keys only in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://api.nimmiai.in/api/payments/webhook, event payment.captured
RAZORPAY_WEBHOOK_SECRET=

# ─── Email (password reset, lead alerts, team invites) ────────────
# Either Resend (recommended, https://resend.com/) ...
RESEND_API_KEY=
EMAIL_FROM=Nimmi AI <notifications@nimmiai.in>
# ... or SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Gets "number requested" and "KYC documents ready" alerts for phone numbers.
OPS_EMAIL=

# ─── Voice engine (Sarvam AI) ─────────────────────────────────────
# REQUIRED for any voice call, test calls included. https://dashboard.sarvam.ai/
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
# false keeps a whole sentence as one turn (tested); true splits at comma pauses.
SARVAM_HIGH_VAD_SENSITIVITY=false
# Voice replies: Groq is used first when GROQ_API_KEY is set (fastest), else this Gemini model.
VOICE_GEMINI_MODEL=gemini-flash-lite-latest
VOICE_GROQ_MODEL=qwen/qwen3.8-27b

# ─── Phone calls (Exotel) ─────────────────────────────────────────
# Inbound calls and lead callbacks. Flow setup is described in voice/exotel.py.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# api.exotel.com (Singapore) or api.in.exotel.com (Mumbai)
EXOTEL_SUBDOMAIN=api.in.exotel.com
# The Exotel flow (app) that contains the Voicebot applet; used for outbound callbacks.
EXOTEL_APP_ID=
# Random string in the Voicebot/Passthru URLs so only Exotel can reach them.
EXOTEL_WS_SECRET=
# For ops: POST /api/voice/admin/numbers/{id}/activate with header X-Admin-Key. At least 24 random characters.
ADMIN_API_KEY=

# ─── Phone calls (Twilio) ─────────────────────────────────────────
# For testing and customers outside India (Twilio can't give Indian numbers for domestic calls).
# Console home page: Account SID + Auth Token. Point the number with the admin activate endpoint (provider=twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WS_SECRET=
# Self-serve numbers (Twilio, outside India), paid monthly from the customer's Nimmi balance.
# Customer fee = Twilio's monthly price x USD_INR_RATE x NUMBER_FEE_MARKUP, rounded up to Rs 10 (min Rs 99).
# Unpaid numbers pause, then are released after NUMBER_GRACE_DAYS. Buying needs an upgraded (paid) Twilio account.
USD_INR_RATE=85
NUMBER_FEE_MARKUP=2.0
NUMBER_GRACE_DAYS=7
# The backend's public https address, used in Twilio's call instructions.
PUBLIC_BACKEND_URL=https://api.nimmiai.in

# ─── WhatsApp confirmations (Meta Cloud API) ──────────────────────
# https://business.facebook.com/ > WhatsApp Manager. Templates must be approved by Meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Two-way WhatsApp chat (each workspace saves its own number and token under Integrations).
# App secret: Meta for Developers > your app > App settings > Basic. Used to verify that webhook
# calls really come from Meta; without it the webhook only works with LOCAL_DEV=true.
WHATSAPP_APP_SECRET=
# Webhook verify token accepted for every workspace (each workspace also gets its own).
WHATSAPP_VERIFY_TOKEN=

# ─── Google Sheets flow node ──────────────────────────────────────
# Service account JSON file; share each sheet with the service account email.
GOOGLE_SHEETS_KEY_PATH=google_sheets_key.json

# ─── Business settings (change without a deploy) ──────────────────
VOICE_TRIAL_MINUTES=30
VOICE_NUMBER_MONTHLY_FEE=999
# [{"id":"p_100","minutes":100,"price":549}, ...]  (INR, the amount charged)
VOICE_PACKS_JSON=
# Monthly voice minutes included per bot plan, e.g. {"6 Month Plan": 60}
VOICE_PLAN_MINUTES_JSON=
# Bots whose demo page works for anyone (marketing demos), comma-separated ids.
DEMO_BOT_IDS=

# Encrypts stored secrets (customers' AI keys, WhatsApp/CRM tokens, Twilio/Exotel keys) and backups.
# Any long random string. Set it once, never change it, and keep a copy outside Railway (e.g. a password
# manager): without it, encrypted secrets and backups can't be read.
ENCRYPTION_KEY=
# If ENCRYPTION_KEY was ever replaced, put the old value(s) here (comma-separated) so secrets saved under them
# can still be read. New secrets always use ENCRYPTION_KEY.
# ENCRYPTION_OLD_KEYS=

# ─── Security and data safety ─────────────────────────────────────
# Daily encrypted database backup to the private Supabase bucket "backups" (needs SUPABASE_SERVICE_ROLE_KEY).
BACKUPS=on
BACKUP_KEEP_DAYS=30
# Countries we place calls to (calling codes). Blocks premium-rate fraud from web forms and uploaded lists.
CALL_COUNTRY_CODES=91,1,44,61
# Most automatic customer emails one workspace can queue a day (stops fake leads being used to spam).
AUTOMATION_DAILY_CAP=500
# Proxies in front of the app that add X-Forwarded-For (Railway = 1; Cloudflare + Railway = 2).
TRUSTED_PROXY_HOPS=1
# Twilio webhooks must carry Twilio's signature. Only set to false for local tests.
TWILIO_VERIFY_SIGNATURES=true
